# Docker Management MCP Server - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Claude Code Authentication
# ============================================================================
# Modes:
# - auto: use ANTHROPIC_API_KEY if set, otherwise use existing Claude Code login
# - api: require ANTHROPIC_API_KEY
# - subscription: use Claude Code subscription login only
CLAUDE_AUTH_MODE=auto

# Get your API key from: https://console.anthropic.com/
# Optional in auto/subscription mode, required in api mode
ANTHROPIC_API_KEY=

# ============================================================================
# Portainer Configuration
# ============================================================================
# Portainer URL
# Use host.docker.internal to access host services from container
PORTAINER_URL=http://host.docker.internal:9000

# Portainer API Token
# Generate from: Portainer UI -> Account Settings -> Access Tokens
PORTAINER_TOKEN=ptr_your_token_here

# Portainer Endpoint ID (usually 1 for primary endpoint)
PORTAINER_ENDPOINT_ID=1

# ============================================================================
# File System Paths
# ============================================================================
# Directory where Docker stacks are stored
STACKS_DIR=/home/liam/docker/stacks

# Directory where Docker volumes are stored
VOLUMES_DIR=/home/liam/docker/volumes

# ============================================================================
# Server Configuration
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Domain for MCP server (if using Traefik)
DOCKER_MCP_DOMAIN=dockermcp.bramleyvale.com

# ============================================================================
# Job Management
# ============================================================================
# Maximum age for completed jobs (hours) before cleanup
MAX_JOB_AGE_HOURS=24

# Interval between job cleanup runs (minutes)
JOB_CLEANUP_INTERVAL_MINUTES=60
